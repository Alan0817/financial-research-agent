LLM_PROVIDER=gemini
LLM_MODEL=
# Optional provider-specific fallbacks when LLM_MODEL is unset.
OPENAI_MODEL=
GEMINI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
RETRIEVAL_BACKEND=hybrid
# Optional local retrieval model overrides.
SEC_EMBEDDING_MODEL=
SEC_RERANKER_MODEL=
# Documented adapter choice; application composition injects the provider.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEC_USER_AGENT="FinancialResearchAgent your-email@example.com"

# Portfolio Demo API. LIVE mode is disabled unless explicitly enabled.
DEMO_LIVE_ENABLED=false
# Comma-separated browser origins. Leave blank for no cross-origin access.
DEMO_CORS_ORIGINS=http://localhost:5173
