# Public browser configuration only. Never place API keys in Vite variables.
# API mode uses FastAPI. Static mode reads validated exported showcase assets.
VITE_DEMO_MODE=api
VITE_API_BASE_URL=http://localhost:8000
# Optional Vite public base, for example /financial-research-agent/ on project Pages.
VITE_BASE_PATH=/
# Optional: the public repository URL displayed by the project page.
VITE_GITHUB_URL=https://github.com/your-account/your-repository
